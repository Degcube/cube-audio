<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Color x:Key="BgColor">#121214</Color>
  <Color x:Key="SurfaceColor">#1A1A1D</Color>
  <Color x:Key="SurfaceHoverColor">#1F2025</Color>
  <Color x:Key="BorderColor">#282829</Color>
  <Color x:Key="BorderHoverColor">#3F3F43</Color>
  <Color x:Key="PrimaryColor">#2DD4BF</Color>
  <Color x:Key="PrimaryHoverColor">#5EEAD4</Color>

  <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}" />
  <SolidColorBrush x:Key="Surface" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="SurfaceHover" Color="{StaticResource SurfaceHoverColor}" />
  <SolidColorBrush x:Key="Border" Color="{StaticResource BorderColor}" />
  <SolidColorBrush x:Key="BorderHover" Color="{StaticResource BorderHoverColor}" />
  <SolidColorBrush x:Key="Text" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Text75" Color="#BFFFFFFF" />
  <SolidColorBrush x:Key="Text50" Color="#80FFFFFF" />
  <SolidColorBrush x:Key="Text25" Color="#40FFFFFF" />
  <SolidColorBrush x:Key="Text10" Color="#1AFFFFFF" />
  <SolidColorBrush x:Key="Primary" Color="{StaticResource PrimaryColor}" />
  <SolidColorBrush x:Key="PrimaryHover" Color="{StaticResource PrimaryHoverColor}" />
  <SolidColorBrush x:Key="PrimarySoft" Color="#1F2DD4BF" />
  <SolidColorBrush x:Key="PrimaryContrast" Color="#0B0B0C" />
  <SolidColorBrush x:Key="Danger" Color="#F87171" />

  <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
  <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>

  <Style TargetType="ToolTip">
    <Setter Property="Background" Value="{StaticResource Surface}" />
    <Setter Property="Foreground" Value="{StaticResource Text75}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderHover}" />
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="8,5">
            <ContentPresenter />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="Button">
    <Setter Property="Background" Value="{StaticResource Surface}" />
    <Setter Property="Foreground" Value="{StaticResource Text75}" />
    <Setter Property="BorderBrush" Value="{StaticResource Text10}" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceHover}" />
              <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource BorderHover}" />
              <Setter Property="Foreground" Value="{StaticResource Text}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{StaticResource Bg}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{StaticResource Primary}" />
    <Setter Property="Foreground" Value="{StaticResource PrimaryContrast}" />
    <Setter Property="BorderBrush" Value="{StaticResource Primary}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{StaticResource PrimaryHover}" />
              <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource PrimaryHover}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ToolButton" TargetType="ToggleButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource Text75}" />
    <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="5">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceHover}" />
              <Setter Property="Foreground" Value="{StaticResource Text}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{StaticResource PrimarySoft}" />
              <Setter TargetName="Root" Property="BorderBrush" Value="#552DD4BF" />
              <Setter Property="Foreground" Value="{StaticResource Primary}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SliderThumb" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Ellipse x:Name="Dot" Width="12" Height="12" Fill="{StaticResource Text}" />
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Dot" Property="Fill" Value="{StaticResource PrimaryHover}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SliderFill" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="Slider">
    <Setter Property="Height" Value="20" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsMoveToPointEnabled" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Track x:Name="PART_Track" VerticalAlignment="Center">
            <Track.DecreaseRepeatButton>
              <RepeatButton Style="{StaticResource SliderFill}" Background="{StaticResource Primary}" Command="Slider.DecreaseLarge" />
            </Track.DecreaseRepeatButton>
            <Track.Thumb>
              <Thumb Style="{StaticResource SliderThumb}" />
            </Track.Thumb>
            <Track.IncreaseRepeatButton>
              <RepeatButton Style="{StaticResource SliderFill}" Background="{StaticResource Text25}" Command="Slider.IncreaseLarge" />
            </Track.IncreaseRepeatButton>
          </Track>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ContextMenu">
    <Setter Property="Background" Value="{StaticResource Surface}" />
    <Setter Property="Foreground" Value="{StaticResource Text75}" />
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="HasDropShadow" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <Border Background="{TemplateBinding Background}" BorderBrush="{StaticResource BorderHover}" BorderThickness="1" CornerRadius="6" Padding="4" MinWidth="190">
            <ItemsPresenter />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="MenuItem">
    <Setter Property="Foreground" Value="{StaticResource Text75}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Border x:Name="Root" Background="Transparent" CornerRadius="4" Padding="10,6">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="22" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="Check" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource Primary}" Visibility="Collapsed" />
              <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Margin="24,0,0,0" Foreground="{StaticResource Text25}" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceHover}" />
              <Setter Property="Foreground" Value="{StaticResource Text}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Check" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Label" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Text50}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Margin" Value="0,0,0,6" />
  </Style>

</ResourceDictionary>
