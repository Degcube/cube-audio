<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <SelfContained>false</SelfContained>
    <RollForward>LatestPatch</RollForward>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\CubeAudio.ico</ApplicationIcon>
    <Product>CubeAudio</Product>
    <Description>Microphone boost without a virtual audio device</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <PublishReadyToRun>true</PublishReadyToRun>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="3.1.0" />
  </ItemGroup>

  <PropertyGroup>
    <ApoDirectory>$(MSBuildProjectDirectory)\..\CubeAudio.Apo</ApoDirectory>
  </PropertyGroup>

  <ItemGroup>
    <ApoSource Include="$(ApoDirectory)\Apo.cpp;$(ApoDirectory)\Apo.def;$(ApoDirectory)\Apo.rc;$(ApoDirectory)\Booster.h;$(ApoDirectory)\Contract.h;$(ApoDirectory)\CubeAudio.Apo.vcxproj;$(ApoDirectory)\build.ps1;$(MSBuildProjectDirectory)\..\Directory.Build.props" />
    <Content Include="$(ApoDirectory)\bin\CubeAudioApo.dll" Link="CubeAudioApo.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <Target Name="BuildApo" BeforeTargets="PrepareForBuild" Inputs="@(ApoSource)" Outputs="$(ApoDirectory)\bin\CubeAudioApo.dll">
    <Exec Command="pwsh -NoProfile -File &quot;$(ApoDirectory)\build.ps1&quot;" />
  </Target>

</Project>
