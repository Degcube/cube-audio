<Window x:Class="CubeAudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CubeAudio.Controls"
        Title="CubeAudio"
        Width="440"
        SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}"
        Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13"
        UseLayoutRounding="True">
  <StackPanel>

    <Border Height="52" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
      <DockPanel Margin="16,0">
        <Button x:Name="MicrophoneButton" DockPanel.Dock="Right" VerticalAlignment="Center" Click="OnMicrophoneClick" ToolTip="Microphone">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE720;" FontFamily="{StaticResource IconFont}" Margin="0,0,8,0" VerticalAlignment="Center" />
            <TextBlock x:Name="MicrophoneName" Text="No microphone" MaxWidth="190" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="9" Margin="8,1,0,0" VerticalAlignment="Center" />
          </StackPanel>
          <Button.ContextMenu>
            <ContextMenu x:Name="MicrophoneMenu" Placement="Bottom" />
          </Button.ContextMenu>
        </Button>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="24" Height="24" CornerRadius="6" Background="{StaticResource Primary}">
            <TextBlock Text="&#xE720;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{StaticResource PrimaryContrast}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="CubeAudio" FontWeight="SemiBold" FontSize="14" Margin="10,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
      </DockPanel>
    </Border>

    <StackPanel x:Name="BoostPanel" Margin="20,18,20,0">
      <DockPanel>
        <ToggleButton x:Name="EnabledToggle" DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Content="&#xE7E8;" Click="OnEnabledClick" ToolTip="Boost on / off" />
        <StackPanel>
          <TextBlock Text="BOOST" Style="{StaticResource Label}" FontSize="11" Margin="0" />
          <TextBlock x:Name="GainText" Text="+12 dB" FontSize="34" FontWeight="SemiBold" Margin="0,2,0,0" />
        </StackPanel>
      </DockPanel>
      <Slider x:Name="GainSlider" Minimum="0" Maximum="30" TickFrequency="0.5" IsSnapToTickEnabled="True" SmallChange="0.5" LargeChange="1" Margin="0,10,0,0" ValueChanged="OnGainChanged" />
      <DockPanel Margin="0,2,0,0">
        <TextBlock DockPanel.Dock="Right" Text="+30 dB" Foreground="{StaticResource Text25}" FontSize="11" />
        <TextBlock Text="0 dB" Foreground="{StaticResource Text25}" FontSize="11" />
      </DockPanel>
    </StackPanel>

    <StackPanel Margin="20,22,20,0">
      <DockPanel>
        <TextBlock x:Name="LevelText" DockPanel.Dock="Right" Foreground="{StaticResource Text50}" FontSize="12" />
        <TextBlock Text="LEVEL, AS OTHER APPS HEAR IT" Style="{StaticResource Label}" FontSize="11" />
      </DockPanel>
      <controls:LevelBar x:Name="Level" Height="12" ToolTip="Your voice should peak in the brighter part. Red means the limiter is holding it back." />
    </StackPanel>

    <Grid Margin="20,20,20,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="10" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Button x:Name="CalibrateButton" Click="OnCalibrateClick" HorizontalContentAlignment="Center" ToolTip="Talk for 5 seconds and CubeAudio picks the boost">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource IconFont}" Margin="0,0,8,0" VerticalAlignment="Center" />
          <TextBlock Text="Auto-calibrate" />
        </StackPanel>
      </Button>
      <Button x:Name="TestButton" Grid.Column="2" Click="OnTestClick" HorizontalContentAlignment="Center" ToolTip="Record 5 seconds and play them back">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" Margin="0,0,8,0" VerticalAlignment="Center" />
          <TextBlock Text="Test recording" />
        </StackPanel>
      </Button>
    </Grid>
    <TextBlock x:Name="Hint" Margin="20,12,20,0" MinHeight="34" TextWrapping="Wrap" Foreground="{StaticResource Text50}" FontSize="12" />

    <Border Margin="0,12,0,0" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="20,12">
      <DockPanel>
        <Button x:Name="InstallButton" DockPanel.Dock="Right" VerticalAlignment="Center" Click="OnInstallClick" />
        <Ellipse x:Name="StateDot" Width="8" Height="8" VerticalAlignment="Center" Fill="{StaticResource Text25}" />
        <TextBlock x:Name="StateText" Margin="10,0,12,0" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource Text75}" />
      </DockPanel>
    </Border>

  </StackPanel>
</Window>
